{
  "name": "rational-primer-design",
  "version": "1.0.3",
  "private": true,
  "description": "Rational Primer Design — Desktop application",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"npm run dev:frontend\" \"sleep 3 && npm run dev:electron\"",
    "dev:frontend": "cd frontend && npx next dev -p 3001",
    "dev:electron": "NODE_ENV=development electron . --dev",
    "build:frontend": "cd frontend && npx next build",
    "build:backend": "pyinstaller --clean backend.spec",
    "build": "npm run build:frontend && npm run build:backend",
    "start": "electron .",
    "package:mac": "electron-builder --mac --config.extraMetadata.main=electron/main.js",
    "package:win": "electron-builder --win --config.extraMetadata.main=electron/main.js",
    "package:linux": "electron-builder --linux --config.extraMetadata.main=electron/main.js",
    "postinstall": "cd frontend && npm install"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "electron": "^34.3.0",
    "electron-builder": "^25.1.0"
  },
  "build": {
    "appId": "com.rational-primer-design.app",
    "productName": "Rational Primer Design",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "frontend/out/**/*"
    ],
    "extraResources": [
      {
        "from": "dist/backend",
        "to": "backend"
      }
    ],
    "mac": {
      "category": "public.app-category.medical",
      "target": [
        {
          "target": "dmg",
          "arch": ["arm64", "x64"]
        }
      ],
      "icon": "logo.png",
      "hardenedRuntime": true,
      "gatekeeperAssess": false
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "icon": "logo.png"
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "Science",
      "icon": "logo.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
